{
    "name": "mnarushevich/laravel-audit-logs",
    "description": "A Laravel package for audit logging",
    "type": "library",
    "autoload": {
        "psr-4": {
            "MNarushevich\\AuditLogs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MNarushevich\\AuditLogs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MNarushevich\\AuditLogs\\AuditLogsServiceProvider"
            ],
            "aliases": {
                "AuditLogs": "MNarushevich\\AuditLogs\\Facades\\AuditLogs"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0"
    },
    "require-dev": {
        "rector/rector": "^2.1",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "scripts": {
        "rector": "rector",
        "test:rector": "rector --dry-run",
        "test:unit": "pest --colors=always --stop-on-failure",
        "test": [
            "@test:rector",
            "@test:unit"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
